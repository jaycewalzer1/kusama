        "type": "group",
        "clip": { "type": "polygon", "points": [[260, 40], [480, 260], [260, 480], [40, 260]] },
        "note": "A rotated square as a polygon clip. Under default-v0 the clip could not be turned.",
        "children": [
          {
            "id": "d-ground",
            "type": "op",
            "op": "paint",
            "rngKey": "d-ground",
            "args": {
              "region": { "type": "rect", "x": 0, "y": 0, "w": 520, "h": 520 },
              "style": { "kind": "solid", "color": "acid", "opacity": 255 }
            }
          },
          {
            "id": "d-stripes",
            "type": "repeat",
            "rngKey": "d-stripes",
            "count": 9,
            "layout": { "type": "line", "origin": [30, 60], "dx": 0, "dy": 50 },
            "children": [
              {
                "id": "stripe",
                "type": "op",
                "op": "paint",
                "rngKey": "stripe",
                "args": {
                  "region": { "type": "rect", "x": 0, "y": 0, "w": 460, "h": 22 },
                  "style": { "kind": "solid", "color": "bruise", "opacity": 255 }
                }
              }
            ]
          },
          {
            "id": "wedge",
            "type": "group",
            "clip": { "type": "polygon", "points": [[200, 120], [460, 200], [420, 420], [180, 380]] },
            "note": "A clip inside a clip. Two convex polygons intersect to a convex polygon, so this is still a legal clip for everything below it.",
            "children": [
              {
                "id": "w-fill",
                "type": "op",
                "op": "paint",
                "rngKey": "w-fill",
                "args": {
                  "region": { "type": "rect", "x": 0, "y": 0, "w": 520, "h": 520 },
                  "style": { "kind": "solid", "color": "ink", "opacity": 255 }
                }
              },
              {
                "id": "w-bird",
                "type": "op",
                "op": "fragment",
                "rngKey": "w-bird",
                "args": {
                  "name": "animal.bird",
                  "x": 310,
                  "y": 270,
                  "span": 200,
                  "rotate": 12,
                  "style": { "kind": "solid", "color": "acid", "opacity": 255 }
                }
              }
            ]
          }
        ]
      },
      {
        "id": "flag",
        "type": "group",
        "clip": { "type": "polygon", "points": [[40, 530], [480, 510], [480, 610], [40, 640]] },
