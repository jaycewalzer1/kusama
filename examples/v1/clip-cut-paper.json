{
  "version": "0.2",
  "profile": "default-v1",
  "assetPack": "core-v1",
  "canvas": { "width": 520, "height": 700, "ground": "#e8e4d8", "brushScale": 1.5 },
  "seed": 71144,
  "palette": { "ink": "#101010", "acid": "#c8d400", "bruise": "#4a2352" },
  "print": [{ "stage": "posterize", "levels": 4 }],
  "meta": {
    "note": "Author two on the same capability: cut paper, not apertures. Angled convex polygons, a nested clip that intersects to a smaller polygon, and a print stage on top so the edges read as printed rather than drawn."
