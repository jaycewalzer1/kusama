{
  "version": "0.2",
  "profile": "default-v0",
  "assetPack": "core",
  "seed": 5504,
  "canvas": { "width": 800, "height": 1200, "ground": "#0b0b0c", "brushScale": 1 },
  "palette": {
    "dark": "#0b0b0c",
    "bone": "#e4e0d4",
    "blood": "#bf1b1b",
    "ash": "#59594f"
