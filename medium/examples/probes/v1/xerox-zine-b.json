          "y": 712,
          "align": "left",
          "color": "paper",
          "tracking": 2
        }
      },
      {
        "id": "col-e",
        "type": "op",
        "op": "text",
        "rngKey": "xzb/col-e",
        "args": {
          "text": "Fig. 1 is any of us. It was a crowd once and the copier decided it was a shape. We kept the shape, because the shape is what survives.",
