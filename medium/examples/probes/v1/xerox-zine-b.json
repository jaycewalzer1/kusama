        "op": "text",
        "rngKey": "xzb/col-a",
        "label": "the left column, which in v0 was 46 paper bars with 62 plate bars scattered back over them for the rag",
        "args": {
          "text": "This is the second generation. The first was somebody else's and we never saw it. It came off a machine at half past two in a room that was not ours, and it is already worse.",
          "font": "space-mono",
          "size": 16,
          "x": 88,
          "y": 400,
          "align": "left",
          "color": "paper",
          "maxWidth": 288,
          "leading": 1.3
