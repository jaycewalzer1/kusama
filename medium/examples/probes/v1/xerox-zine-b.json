      },
      {
        "id": "col-b",
        "type": "op",
        "op": "text",
        "rngKey": "xzb/col-b",
        "args": {
          "text": "Nothing here is original. The type is borrowed, the picture is a picture of a picture, and the machine took a percentage of both. That is the arrangement. Nobody objects.",
          "font": "space-mono",
          "size": 16,
          "x": 88,
          "y": 550,
          "align": "left",
          "color": "paper",
          "maxWidth": 288,
          "leading": 1.3
        }
      },
      {
        "id": "col-c",
        "type": "op",
        "op": "text",
        "rngKey": "xzb/col-c",
        "args": {
          "text": "Every pass loses something. Thin lines go first, then the insides of the letters, then the difference between a face and a smudge. Read it now, while there is still a now.",
          "font": "space-mono",
          "size": 16,
          "x": 88,
          "y": 700,
          "align": "left",
          "color": "paper",
          "maxWidth": 288,
          "leading": 1.3
