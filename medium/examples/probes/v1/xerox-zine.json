{
  "version": "0.2",
  "profile": "default-v1",
  "assetPack": "core-v1",
  "seed": 4101,
  "canvas": { "width": 800, "height": 1200, "ground": "#e9e7e0", "brushScale": 1 },
  "palette": {
    "toner": "#0d0d0d",
    "paper": "#e9e7e0",
    "grey": "#8e8b83"
  },
  "print": [
    {
      "stage": "generation",
      "passes": 3,
      "cut": 0.52,
      "dark": "toner",
      "light": "paper",
      "blur": 1,
      "spread": 0,
      "dropout": 0.03,
      "speck": 0.01
    },
    { "stage": "paper", "tint": "grey", "amount": 0.2, "vignette": 0.22 },
    { "stage": "grain", "amount": 0.05, "mono": true }
  ],
  "meta": {
    "probe": "xerox-zine",
    "target": "a photocopied zine page: high contrast black on grey copier stock, degraded edges, typewriter body text, visible generational loss",
    "method": "the same page as examples/probes/xerox-zine.json, re-authored against default-v1. The three repeats that hand-drew the degradation (110 masthead flecks, 70 footer flecks, 190 platen specks) are deleted; `generation` at 3 passes now produces the dropout and the specks by re-thresholding a blurred copy of the copy, which is what the object actually is. The clean 7-gon `cover` bite is replaced by a torn fragment. Typewriter is a typewriter face with per-glyph jitter rather than PT Serif tracked out.",
    "v0": "xerox-zine, profile default-v0, pack core"
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "stock",
        "type": "op",
        "op": "wash",
        "rngKey": "xz/stock",
        "label": "copier stock. Kept from v0, and the print pass flattens it: after `generation` this wash and the bare ground are the same tone, so it now survives only in trace.plate",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "grey", "opacity": 34, "bleed": 0.08, "texture": [0.85, 0.55] }
        }
      },
      {
        "id": "gutter",
        "type": "group",
        "blend": "multiply",
        "label": "multiply, so the spine shadow darkens the stock it lies on instead of replacing it",
        "children": [
          {
            "id": "gutter-shadow",
            "type": "op",
            "op": "wash",
            "rngKey": "xz/gutter",
            "label": "the dark band a copier leaves along the spine edge",
            "args": {
              "region": { "type": "rect", "x": -20, "y": -20, "w": 66, "h": 1240 },
              "style": { "kind": "wash", "color": "toner", "opacity": 130, "bleed": 0.34, "texture": [0.7, 0.4] }
            }
          }
        ]
      },
      {
        "id": "masthead",
        "type": "group",
        "label": "solid black bar with the title knocked out of it",
        "children": [
          {
            "id": "masthead-bar",
            "type": "op",
            "op": "paint",
            "rngKey": "xz/masthead-bar",
            "args": {
              "region": { "type": "rect", "x": 46, "y": 74, "w": 712, "h": 168 },
              "style": { "kind": "solid", "color": "toner", "opacity": 255 }
            }
          },
          {
            "id": "masthead-title",
            "type": "op",
            "op": "text",
            "rngKey": "xz/masthead-title",
            "label": "anton, stretched wide: a display face enlarged past its size on the platen",
            "args": {
              "text": "DEAD AIR",
              "font": "anton",
              "size": 112,
              "x": 402,
              "y": 190,
              "align": "center",
              "color": "paper",
              "tracking": 8,
              "stretch": [1.25, 1.05]
            }
          },
          {
            "id": "masthead-issue",
            "type": "op",
            "op": "text",
            "rngKey": "xz/masthead-issue",
            "args": {
              "text": "ISSUE SEVEN / FREE / NOT FOR RESALE",
              "font": "courier-prime",
              "size": 13,
              "x": 402,
              "y": 268,
              "align": "center",
              "color": "toner",
              "tracking": 1.5
            }
          }
        ]
      },
      {
        "id": "plate",
        "type": "group",
        "clip": { "type": "rect", "x": 46, "y": 306, "w": 712, "h": 430 },
        "label": "the photograph. The clip is what makes it a plate: in v0 the crowd hung 32px below the black and the streaks overshot it",
        "children": [
          {
            "id": "plate-ground",
            "type": "op",
            "op": "paint",
            "rngKey": "xz/plate-ground",
            "args": {
              "region": { "type": "rect", "x": 46, "y": 306, "w": 712, "h": 430 },
              "style": { "kind": "solid", "color": "toner", "opacity": 255 }
            }
          },
          {
            "id": "plate-crowd",
            "type": "op",
            "op": "fragment",
            "rngKey": "xz/plate-crowd",
            "args": {
              "name": "figure.crowd",
              "x": 402,
              "y": 590,
              "span": 660,
              "style": { "kind": "solid", "color": "paper", "opacity": 255 }
            }
          },
          {
            "id": "plate-standing",
            "type": "op",
            "op": "fragment",
            "rngKey": "xz/plate-standing",
            "args": {
              "name": "figure.standing",
              "x": 210,
              "y": 470,
              "span": 250,
              "style": { "kind": "solid", "color": "paper", "opacity": 255 }
            }
          },
          {
            "id": "plate-hand",
            "type": "op",
            "op": "fragment",
            "rngKey": "xz/plate-hand",
            "args": {
              "name": "hand.open",
              "x": 596,
              "y": 452,
              "span": 220,
              "rotate": 14,
              "style": { "kind": "solid", "color": "paper", "opacity": 255 }
            }
          },
          {
            "id": "plate-streaks",
            "type": "repeat",
            "rngKey": "xz/plate-streaks",
            "label": "the drag a dirty drum leaves down the page",
            "count": 9,
            "layout": { "type": "line", "origin": [46, 344], "dx": 0, "dy": 43 },
            "jitter": { "translate": 5 },
            "children": [
              {
                "id": "streak",
                "type": "op",
                "op": "paint",
                "rngKey": "xz/streak",
                "args": {
                  "region": { "type": "rect", "x": 0, "y": 0, "w": 712, "h": 1.5 },
                  "style": { "kind": "solid", "color": "paper", "opacity": 190 }
                }
              }
            ]
          },
          {
            "id": "plate-bite",
            "type": "op",
            "op": "fragment",
            "rngKey": "xz/plate-bite",
            "label": "the torn corner. Was a 7-point cover polygon; now a torn fragment whose deckle is geometry, clipped flush at the two plate edges so only the ripped arc shows",
            "args": {
              "name": "mark.sponsor-c",
              "x": 744,
              "y": 316,
              "span": 230,
              "rotate": 12,
              "tear": { "roughness": 0.62, "segment": 6 },
              "style": { "kind": "solid", "color": "paper", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "body",
        "type": "group",
        "label": "typewriter setting: an actual typewriter face, struck unevenly",
        "children": [
          {
            "id": "body-rule",
            "type": "op",
            "op": "rule",
            "rngKey": "xz/body-rule",
            "args": { "from": [46, 780], "to": [758, 780], "brush": "charcoal", "color": "toner", "weight": 2.5 }
          },
          {
            "id": "body-text",
            "type": "op",
            "op": "text",
            "rngKey": "xz/body-text",
            "label": "special-elite with per-glyph translate and rotate: a ribbon impression that never lands twice in the same place",
            "args": {
              "text": "THE MACHINE RUNS ALL NIGHT AND NOBODY SIGNS FOR IT. EVERY COPY IS WORSE THAN THE LAST AND THAT IS THE ONLY HONEST RECORD WE HAVE.",
              "font": "special-elite",
              "size": 19,
              "x": 46,
              "y": 826,
              "align": "left",
              "color": "toner",
              "tracking": 0.5,
              "leading": 1.45,
              "maxWidth": 470,
              "jitter": { "translate": 0.5, "rotate": 1 }
            }
          },
          {
            "id": "body-notice",
            "type": "macro",
            "macro": "quarantine",
            "rngKey": "xz/body-notice",
            "label": "a boxed notice, hatched so it reads as a screened panel",
            "args": {
              "x": 542,
              "y": 800,
              "w": 216,
              "h": 124,
              "style": { "kind": "hatch", "brush": "rotring", "color": "toner", "spacing": 3, "angle": 0, "rand": 0.4, "layers": 1 },
              "boxBrush": "rotring",
              "boxColor": "toner",
              "boxWeight": 2,
              "label": "REMOVED BY HAND",
              "labelFont": "allerta-stencil",
              "labelSize": 12,
              "labelTracking": 2
            }
          },
          {
            "id": "body-stamp",
            "type": "op",
            "op": "text",
            "rngKey": "xz/body-stamp",
            "label": "a rubber stamp: stencil face, set crooked, every letter landing at its own angle",
            "args": {
              "text": "COPY OF A COPY OF A COPY",
              "font": "stardos-stencil",
              "size": 42,
              "x": 46,
              "y": 998,
              "align": "left",
              "color": "toner",
              "tracking": 4,
              "rotate": -2,
              "stretch": [1.15, 1],
              "jitter": { "translate": 1, "rotate": 2 }
            }
          },
          {
            "id": "body-strike",
            "type": "op",
            "op": "stroke",
            "rngKey": "xz/body-strike",
            "label": "biro through the line, the one hand-made mark",
            "args": {
              "points": [[44, 990], [220, 984], [430, 994], [640, 982], [762, 990]],
              "brush": "2B",
              "color": "toner",
              "weight": 2,
              "curve": 0.35
            }
          }
        ]
      },
      {
        "id": "footer",
        "type": "group",
        "label": "black footer bar with the line knocked out of it",
        "children": [
          {
            "id": "footer-bar",
            "type": "op",
            "op": "paint",
            "rngKey": "xz/footer-bar",
            "args": {
              "region": { "type": "rect", "x": 46, "y": 1050, "w": 712, "h": 100 },
              "style": { "kind": "solid", "color": "toner", "opacity": 255 }
            }
          },
          {
            "id": "footer-text",
            "type": "op",
            "op": "text",
            "rngKey": "xz/footer-text",
            "args": {
              "text": "SELF PUBLISHED / NO PERMISSION ASKED",
              "font": "bebas-neue",
              "size": 34,
              "x": 402,
              "y": 1112,
              "align": "center",
              "color": "paper",
              "tracking": 3
            }
          },
          {
            "id": "footer-hand",
            "type": "op",
            "op": "fragment",
            "rngKey": "xz/footer-hand",
            "args": {
              "name": "hand.pointing",
              "x": 700,
              "y": 1000,
              "span": 120,
              "rotate": 104,
              "style": { "kind": "solid", "color": "toner", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "colophon",
        "type": "op",
        "op": "text",
        "rngKey": "xz/colophon",
        "label": "authored in sentence case and forced upper, so `case` is doing the work rather than the keyboard",
        "args": {
          "text": "Photocopied at night / pass it on",
          "font": "courier-prime",
          "size": 14,
          "x": 758,
          "y": 1182,
          "align": "right",
          "color": "toner",
          "tracking": 1.5,
          "case": "upper"
        }
      }
    ]
  }
}
