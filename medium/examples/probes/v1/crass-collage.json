{
  "version": "0.2",
  "profile": "default-v1",
  "assetPack": "core-v1",
  "seed": 1977,
  "canvas": { "width": 800, "height": 1200, "ground": "#e2ded2", "brushScale": 1 },
  "palette": {
    "ink": "#121212",
    "paper": "#e2ded2",
    "blood": "#a41616",
    "grey": "#7d7a72",
    "smoke": "#3b3a36"
  },
  "print": [
    { "stage": "posterize", "levels": 6 },
    { "stage": "misregister", "rngKey": "misregister", "amount": 0.5, "spread": 2 },
    { "stage": "grain", "rngKey": "grain", "amount": 0.07 },
    { "stage": "paper", "tint": "paper", "amount": 0.14, "vignette": 0.22 }
  ],
  "meta": {
    "probe": "crass-collage",
    "of": "examples/probes/crass-collage.json, re-authored against default-v1 / core-v1",
    "target": "Gee Vaucher lineage: found fragments layered as an argument, photographic material set against clean type, anti-war content",
    "method": "the same sheet, same composition, same words. Four things are new. The plate is no longer an axis-aligned rectangle: a convex polygon clip cuts it slightly off square, so the photograph has an edge that was cut rather than an edge that was drawn. The beams and the two columns carry a tear, so the pieces inside it are torn out of something. The grey and smoke marks on the black plate sit under a screen blend, which is the only way p5.brush will put light over dark at all (NOTES L4). And the sheet is printed: posterize, misregister, grain, paper.",
    "notDone": "still no photographic or found material -- fifteen hand-drawn vector outlines and no image input in the schema. Still no continuous tone that can be aimed: the print pass will make values between the palette colours (paper.vignette is a real ramp, grain is real noise) but only in the one shape the stage happens to have. halftone, threshold and generation all reduce the whole sheet to two colours, so a montage that carries one red cannot use any of them; the print pass is global and has no way to screen the photograph and leave the type alone."
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "stock",
        "type": "op",
        "op": "wash",
        "rngKey": "crass/stock",
        "label": "cheap paper, so the white is never white",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "grey", "opacity": 34, "bleed": 0.22, "texture": [0.7, 0.4] }
        }
      },
      {
        "id": "kicker",
        "type": "op",
        "op": "text",
        "rngKey": "crass/kicker",
        "args": {
          "text": "A   SERIES   OF   SHOCKS   TO   THE   SYSTEM   /   SHEET   THREE   OF   NINE",
          "font": "barlow-condensed",
          "size": 14,
          "x": 48,
          "y": 74,
          "align": "left",
          "color": "ink",
          "tracking": 2.5
        }
      },
      {
        "id": "plate",
        "type": "group",
        "label": "the photograph that is not a photograph",
        "children": [
          {
            "id": "plate-cut",
            "type": "group",
            "label": "the plate is now a cut shape, not a drawn rectangle",
            "clip": { "type": "polygon", "points": [[45, 93], [755, 98], [751, 619], [43, 614]] },
            "children": [
              {
                "id": "plate-ground",
                "type": "op",
                "op": "paint",
                "rngKey": "crass/plate-ground",
                "args": {
                  "region": { "type": "rect", "x": 48, "y": 96, "w": 704, "h": 520 },
                  "style": { "kind": "solid", "color": "ink", "opacity": 255 }
                }
              },
              {
                "id": "plate-light",
                "type": "group",
                "blend": "screen",
                "label": "everything on this plate that is lighter than the plate. Without screen, pigment mixing keeps it dark.",
                "children": [
                  {
                    "id": "beams",
                    "type": "repeat",
                    "rngKey": "crass/beams",
                    "label": "searchlights, hatched because there is still no gradient, torn because they are cut paper",
                    "count": 3,
                    "layout": { "type": "line", "origin": [200, 320], "dx": 200, "dy": -18 },
                    "children": [
                      {
                        "id": "beam",
                        "type": "op",
                        "op": "fragment",
                        "rngKey": "crass/beam",
                        "args": {
                          "name": "light.beam",
                          "x": 0,
                          "y": 0,
                          "span": 300,
                          "rotate": 8,
                          "tear": { "roughness": 0.4, "segment": 8 },
                          "style": { "kind": "hatch", "brush": "2H", "color": "grey", "spacing": 5, "angle": 78, "rand": 0.2, "layers": 1, "continuous": false }
                        }
                      }
                    ]
                  },
                  {
                    "id": "colonnade-left",
                    "type": "op",
                    "op": "fragment",
                    "rngKey": "crass/colonnade-left",
                    "args": {
                      "name": "arch.column",
                      "x": 150,
                      "y": 350,
                      "span": 300,
                      "tear": { "roughness": 0.25, "segment": 6 },
                      "style": { "kind": "hatch", "brush": "charcoal", "color": "smoke", "spacing": 3, "angle": 90, "rand": 0.35, "layers": 2, "continuous": false }
                    }
                  },
                  {
                    "id": "colonnade-right",
                    "type": "op",
                    "op": "fragment",
                    "rngKey": "crass/colonnade-right",
