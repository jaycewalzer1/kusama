                      "style": { "kind": "hatch", "brush": "charcoal", "color": "smoke", "spacing": 3, "angle": 90, "rand": 0.35, "layers": 2, "continuous": false }
                    }
                  },
                  {
                    "id": "arch",
                    "type": "op",
                    "op": "fragment",
                    "rngKey": "crass/arch",
                    "args": {
                      "name": "arch.arch",
                      "x": 400,
                      "y": 268,
                      "span": 340,
                      "style": { "kind": "outline", "brush": "rotring", "color": "grey", "weight": 2.5 }
                    }
                  }
                ]
              },
              {
                "id": "crowd",
                "type": "repeat",
                "rngKey": "crass/crowd",
                "label": "the crowd is a silhouette because a silhouette is what they were to it. Not torn: tearing a fragment tears the person, not the paper.",
                "count": 5,
                "layout": { "type": "line", "origin": [128, 552], "dx": 136, "dy": 0 },
                "children": [
                  {
                    "id": "crowd-band",
                    "type": "op",
                    "op": "fragment",
                    "rngKey": "crass/crowd-band",
                    "args": {
                      "name": "figure.crowd",
                      "x": 0,
                      "y": 0,
