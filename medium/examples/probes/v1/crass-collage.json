              "text": "FIG.   3   -   CIVILIANS   ARE   ADVISED   THAT   THE   CEREMONY   WILL   PROCEED",
              "font": "courier-prime",
              "size": 12,
              "x": 62,
              "y": 604,
              "align": "left",
              "color": "ink",
              "tracking": 0.5
            }
          }
        ]
      },
      {
        "id": "argument",
        "type": "group",
        "label": "the type, which is clean on purpose",
        "children": [
