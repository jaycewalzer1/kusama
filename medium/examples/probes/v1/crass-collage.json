                    }
                  }
                ]
              },
              {
                "id": "speaker",
                "type": "op",
                "op": "fragment",
                "rngKey": "crass/speaker",
                "args": {
                  "name": "figure.standing",
                  "x": 400,
                  "y": 452,
                  "span": 210,
