{
  "version": "0.2",
  "profile": "default-v1",
  "assetPack": "core-v1",
  "seed": 3307,
  "canvas": { "width": 800, "height": 1200, "ground": "#f0e24b", "brushScale": 1 },
  "palette": {
    "acid": "#f0e24b",
    "ink": "#101010",
    "grime": "#8a8232"
  },
  "print": [
    {
      "stage": "generation",
      "passes": 3,
      "cut": 0.52,
      "dark": "ink",
      "light": "acid",
      "blur": 1,
      "spread": 1,
      "dropout": 0.06,
      "speck": 0.02
    },
    {
      "stage": "paper",
      "tint": "grime",
      "amount": 0.14,
      "vignette": 0.22
    },
    {
      "stage": "grain",
      "amount": 0.09,
      "mono": true
    }
