  "meta": {
    "probe": "rave-flyer-b/v1",
    "of": "examples/probes/rave-flyer-b.json",
    "target": "same target as rave-flyer, opposite economics: a one-colour handbill photocopied onto coloured stock, rather than a saturated colour printed on black",
    "method": "the same handbill re-authored against default-v1. The headline is genuinely condensed -- archivo-black at stretch [0.68, 1.6] -- and the second line genuinely extended and back-slanted at stretch [1.62, 0.88], skew -10. The disc is clipped by a circle rather than by a rect that happened to contain it. The foot has said PHOTOCOPIED NOT PRINTED since v0; a three-pass `generation` stage makes that sentence true.",
    "notDone": "the information block is still two text ops, because maxTextOps is 12 and maxTextLength is 240 and neither moved. Nothing on this sheet is set on a curve."
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "stock",
        "type": "op",
        "op": "wash",
        "rngKey": "rfb/stock",
        "label": "kept from v0, but the `paper` print stage is now what actually dirties the stock",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "grime", "opacity": 24, "bleed": 0.2, "texture": [0.6, 0.35] }
        }
      },
      {
        "id": "top-rule",
        "type": "op",
        "op": "paint",
        "rngKey": "rfb/top-rule",
        "args": {
          "region": { "type": "rect", "x": 48, "y": 48, "w": 704, "h": 10 },
          "style": { "kind": "solid", "color": "ink", "opacity": 255 }
        }
      },
      {
        "id": "kicker",
        "type": "op",
        "op": "text",
        "rngKey": "rfb/kicker",
        "args": {
          "text": "ONE NIGHT ONE ROOM NO GUESTLIST",
          "font": "share-tech-mono",
          "size": 15,
          "x": 400,
          "y": 90,
          "align": "center",
          "color": "ink",
          "tracking": 3
        }
      },
      {
        "id": "ticks",
        "type": "repeat",
        "rngKey": "rfb/ticks",
        "label": "a ring layout is the only non-rectilinear placement in the substrate",
        "count": 48,
