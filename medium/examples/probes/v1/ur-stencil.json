{
  "version": "0.2",
  "profile": "default-v1",
  "assetPack": "core-v1",
  "seed": 4102,
  "canvas": { "width": 800, "height": 1200, "ground": "#0b0b0b", "brushScale": 1 },
  "palette": {
    "black": "#0b0b0b",
    "steel": "#c9c9c4",
    "red": "#c1121f",
    "dim": "#4a4a46"
  },
  "print": [
    { "stage": "misregister", "rngKey": "misregister", "amount": 0.6, "spread": 2 },
    { "stage": "grain", "rngKey": "grain", "amount": 0.05, "mono": true }
  ],
  "meta": {
    "probe": "ur-stencil",
    "reAuthorOf": "examples/probes/ur-stencil.json",
    "target": "Underground Resistance lineage: black and steel plus one red, stencil-cut display type, text as coordinates and orders, no faces, no polish",
    "method": "the same sheet as the v0 probe, re-cut against default-v1. The three ground-coloured bars that faked the stencil bridges are deleted: TRANSMIT is now set in Saira Stencil One, so the bridges are in the letterforms and survive over anything. The catalogue line, the orders block and the four coordinate lines move to a real mono and a real condensed, so the coordinate columns line up because the advance is fixed rather than because the strings were chosen to look tabular. The misregistered word keeps its two plates and gains blend screen, so the overlap of red and steel is a third value rather than the top plate winning. The red slot in each lower chevron is now a convex polygon clip taken from the arrow, so it cannot spill into the notch. print carries misregister and grain: the press is crude, the drawing still is not.",
    "notDone": "still no text on a path, and skew/stretch/jitter are deliberately unused -- this target wants machine-exact marks, and the crudeness it wants belongs to the printing, not to the hand."
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "plate-tone",
        "type": "op",
        "op": "wash",
        "rngKey": "ur/plate-tone",
        "label": "the only brush mark on the sheet: a dull sheen across the plate",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "dim", "opacity": 30, "bleed": 0.14, "texture": [0.6, 0.35] }
        }
      },
      {
        "id": "trim",
        "type": "macro",
        "macro": "frame",
        "rngKey": "ur/trim",
        "args": { "x": 40, "y": 40, "w": 720, "h": 1120, "style": "corners", "arm": 74, "brush": "rotring", "color": "steel", "weight": 2 }
      },
      {
        "id": "head",
        "type": "group",
        "label": "catalogue line and the red bar that is the whole colour budget",
        "children": [
          {
            "id": "cat-rule",
            "type": "op",
            "op": "paint",
            "rngKey": "ur/cat-rule",
            "args": {
              "region": { "type": "rect", "x": 74, "y": 118, "w": 652, "h": 1 },
              "style": { "kind": "solid", "color": "steel", "opacity": 255 }
            }
          },
          {
            "id": "cat-text",
            "type": "op",
            "op": "text",
            "rngKey": "ur/cat-text",
            "label": "a real fixed-advance face, so the slashes fall on the grid instead of near it",
            "args": {
              "text": "CAT.   UR-041   /   TRANSMISSION   FOUR   /   NO   SLEEVE   NOTES",
              "font": "share-tech-mono",
              "size": 12,
              "x": 74,
              "y": 108,
              "align": "left",
              "color": "steel",
              "tracking": 2
            }
          },
          {
            "id": "red-bar",
            "type": "op",
            "op": "paint",
            "rngKey": "ur/red-bar",
            "args": {
              "region": { "type": "rect", "x": 74, "y": 132, "w": 168, "h": 14 },
              "style": { "kind": "solid", "color": "red", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "stencil",
        "type": "group",
        "label": "the stencil word: the bridges are cut into the face, not laid across it",
        "children": [
          {
            "id": "stencil-word",
            "type": "op",
            "op": "text",
            "rngKey": "ur/stencil-word",
            "args": {
              "text": "TRANSMIT",
              "font": "saira-stencil",
              "size": 112,
              "x": 400,
              "y": 320,
              "align": "center",
              "color": "steel",
              "tracking": 5
            }
          }
        ]
      },
      {
        "id": "misreg",
        "type": "group",
        "blend": "screen",
        "label": "second word, printed twice: red plate off by five, steel plate on register, and the overlap is its own colour",
        "children": [
          {
            "id": "misreg-red",
            "type": "op",
            "op": "text",
            "rngKey": "ur/misreg-red",
            "args": {
              "text": "OR   REFUSE",
              "font": "barlow-condensed-black",
              "size": 74,
              "x": 405.5,
              "y": 425,
              "align": "center",
              "color": "red",
              "tracking": 5
            }
          },
          {
            "id": "misreg-steel",
            "type": "op",
            "op": "text",
            "rngKey": "ur/misreg-steel",
            "args": {
              "text": "OR   REFUSE",
              "font": "barlow-condensed-black",
              "size": 74,
              "x": 400,
              "y": 420,
              "align": "center",
              "color": "steel",
              "tracking": 5
            }
          }
        ]
      },
      {
        "id": "orders",
        "type": "group",
        "label": "the orders block: no images, only instructions",
        "children": [
          {
            "id": "orders-box",
            "type": "op",
            "op": "paint",
            "rngKey": "ur/orders-box",
            "args": {
              "region": { "type": "rect", "x": 74, "y": 512, "w": 336, "h": 236 },
              "style": { "kind": "solid", "color": "steel", "opacity": 255 }
            }
          },
          {
            "id": "orders-text",
            "type": "op",
            "op": "text",
            "rngKey": "ur/orders-text",
            "args": {
              "text": "DO   NOT   SLEEP.   ANSWER   THE   CALL.   THE   PROGRAMME   IS   NOT   ON   THE   SLEEVE   AND   NEVER   WAS.",
