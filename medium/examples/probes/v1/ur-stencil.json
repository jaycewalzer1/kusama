            "args": {
              "text": "013   25   19   E",
              "font": "space-mono",
              "size": 24,
              "x": 448,
              "y": 684,
              "align": "left",
              "color": "steel",
              "tracking": 1
            }
          },
          {
            "id": "orders-ticks",
            "type": "repeat",
            "rngKey": "ur/orders-ticks",
            "count": 26,
            "layout": { "type": "line", "origin": [448, 712], "dx": 10.5, "dy": 0 },
            "children": [
              {
                "id": "tick",
                "type": "op",
                "op": "paint",
                "rngKey": "ur/tick",
                "args": {
                  "region": { "type": "rect", "x": 0, "y": 0, "w": 3, "h": 24 },
                  "style": { "kind": "solid", "color": "steel", "opacity": 255 }
                }
              }
            ]
          }
        ]
      },
      {
        "id": "chevrons",
        "type": "repeat",
        "rngKey": "ur/chevrons",
        "label": "hard-edge arrows, the one shape language allowed",
        "count": 14,
        "layout": { "type": "grid", "origin": [74, 800], "cols": 7, "dx": 96, "dy": 92 },
        "children": [
          {
            "id": "chevron",
            "type": "op",
            "op": "paint",
            "rngKey": "ur/chevron",
            "args": {
              "region": { "type": "polygon", "points": [[0, 0], [44, 0], [66, 30], [44, 60], [0, 60], [22, 30]] },
              "style": { "kind": "solid", "color": "steel", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "chevron-cut",
        "type": "repeat",
        "rngKey": "ur/chevron-cut",
        "label": "a red arrow is only an arrow with a red slot cut in it",
        "count": 7,
        "layout": { "type": "grid", "origin": [74, 892], "cols": 7, "dx": 96, "dy": 92 },
        "children": [
          {
            "id": "cut-clip",
            "type": "group",
            "clip": { "type": "polygon", "points": [[22, 0], [44, 0], [66, 30], [44, 60], [22, 60]] },
            "label": "a convex slice of the arrow itself, so the slot ends on the arrow's diagonals and cannot spill into the notch",
            "children": [
              {
                "id": "cut",
                "type": "op",
                "op": "paint",
                "rngKey": "ur/cut",
                "args": {
                  "region": { "type": "rect", "x": 14, "y": 0, "w": 34, "h": 60 },
