{
  "version": "0.2",
  "profile": "default-v1",
  "assetPack": "core-v1",
  "seed": 5504,
  "canvas": { "width": 800, "height": 1200, "ground": "#0b0b0c", "brushScale": 1 },
  "palette": {
    "dark": "#0b0b0c",
    "bone": "#e4e0d4",
    "blood": "#bf1b1b",
    "ash": "#59594f"
  },
  "print": [
    { "stage": "posterize", "levels": 6 },
    { "stage": "misregister", "amount": 0.6, "spread": 2 },
    { "stage": "grain", "amount": 0.1 },
    { "stage": "paper", "tint": "ash", "amount": 0.08, "vignette": 0.3 }
  ],
  "meta": {
    "probe": "crass-collage-b",
    "of": "examples/probes/crass-collage-b.json, re-authored against default-v1 / core-v1",
    "target": "same target as crass-collage, inverted: a montage printed as a negative, white figures on a black field, with the type in the only other colour",
    "method": "same negative, same words, same order. The whole picture now sits under a screen blend, which is what a negative actually needs: p5.brush mixes pigment, so under normal compositing a light brush on a dark ground stays dark (NOTES L4), and the ash sky and the bone arch outline were fighting that. The architecture is cropped by a convex polygon clip, so it is a photograph with a cut edge rather than a rectangle. The columns and the red beam are torn. The beam opts back out of the screen with an explicit blend normal, because a saturated red mass is ink, not light.",
    "notDone": "still no photographic material and still no image input. Continuous tone still cannot be aimed: the print pass makes real intermediate values now -- paper.vignette is a smooth radial ramp and grain is per-pixel noise -- but the ramp is one fixed centred shape and the noise is not tone. halftone would screen the sheet, and it is the whole sheet: it maps every pixel to one of two colours, so it would delete the red. The type is still not knocked out of the image; it is bone type on a blood bar, drawn over the top, exactly as before."
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "grime",
        "type": "op",
        "op": "wash",
        "rngKey": "ccb/grime",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "ash", "opacity": 34, "bleed": 0.25, "texture": [0.6, 0.4] }
        }
      },
      {
        "id": "negative",
        "type": "group",
        "blend": "screen",
        "label": "a negative is light laid over dark, which is the one thing p5.brush will not do by mixing",
        "children": [
          {
            "id": "plate-cut",
            "type": "group",
            "label": "the state architecture, cropped: a photograph has an edge",
            "clip": { "type": "polygon", "points": [[36, 80], [764, 96], [758, 556], [42, 540]] },
            "children": [
              {
                "id": "sky",
                "type": "op",
                "op": "paint",
                "rngKey": "ccb/sky",
                "label": "engraved sky: hatch is still the only tonal thing here and its tone still does not vary",
                "args": {
                  "region": { "type": "rect", "x": 40, "y": 88, "w": 720, "h": 420 },
                  "style": { "kind": "hatch", "brush": "2H", "color": "ash", "spacing": 11, "angle": 68, "rand": 0.2, "layers": 1 }
                }
              },
              {
                "id": "arch",
                "type": "op",
                "op": "fragment",
                "rngKey": "ccb/arch",
                "args": {
                  "name": "arch.arch",
                  "x": 400,
                  "y": 300,
                  "span": 600,
                  "style": { "kind": "outline", "brush": "rotring", "color": "bone", "weight": 2.5 }
                }
              },
              {
                "id": "column-left",
                "type": "op",
                "op": "fragment",
                "rngKey": "ccb/column-left",
                "args": {
                  "name": "arch.column",
                  "x": 152,
                  "y": 400,
                  "span": 300,
                  "tear": { "roughness": 0.3, "segment": 6 },
                  "style": { "kind": "solid", "color": "bone", "opacity": 255 }
                }
              },
              {
                "id": "column-right",
                "type": "op",
                "op": "fragment",
                "rngKey": "ccb/column-right",
                "args": {
                  "name": "arch.column",
                  "x": 648,
                  "y": 400,
                  "span": 300,
                  "flipX": true,
                  "tear": { "roughness": 0.3, "segment": 6 },
                  "style": { "kind": "solid", "color": "bone", "opacity": 255 }
                }
              }
            ]
          },
          {
            "id": "beam-plate",
            "type": "group",
            "blend": "normal",
            "label": "the red opts back out. It is ink on the page, not light through it.",
            "children": [
              {
                "id": "beam",
                "type": "op",
                "op": "fragment",
                "rngKey": "ccb/beam",
                "args": {
                  "name": "light.beam",
                  "x": 400,
                  "y": 340,
                  "span": 420,
                  "tear": { "roughness": 0.45, "segment": 10 },
                  "style": { "kind": "solid", "color": "blood", "opacity": 255 }
                }
              }
            ]
          },
          {
            "id": "crowd",
            "type": "repeat",
            "rngKey": "ccb/crowd",
            "label": "cut out of the page rather than printed on it. Untorn: a tear here would tear the people, not the paper.",
            "count": 6,
            "layout": { "type": "line", "origin": [104, 690], "dx": 118, "dy": 0 },
            "children": [
              {
                "id": "figure",
                "type": "op",
                "op": "fragment",
                "rngKey": "ccb/figure",
                "args": {
                  "name": "figure.crowd",
                  "x": 0,
                  "y": 0,
                  "span": 210,
                  "style": { "kind": "solid", "color": "bone", "opacity": 255 }
                }
              }
            ]
          },
          {
            "id": "speaker",
            "type": "op",
            "op": "fragment",
            "rngKey": "ccb/speaker",
            "args": {
              "name": "figure.standing",
              "x": 400,
              "y": 646,
              "span": 300,
              "style": { "kind": "solid", "color": "bone", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "ground-rule",
        "type": "op",
        "op": "paint",
        "rngKey": "ccb/ground-rule",
        "args": {
          "region": { "type": "rect", "x": 40, "y": 786, "w": 720, "h": 3 },
          "style": { "kind": "solid", "color": "bone", "opacity": 255 }
        }
      },
      {
        "id": "slogan-bar",
        "type": "op",
        "op": "paint",
        "rngKey": "ccb/slogan-bar",
        "args": {
          "region": { "type": "rect", "x": 40, "y": 820, "w": 720, "h": 96 },
          "style": { "kind": "solid", "color": "blood", "opacity": 255 }
        }
      },
      {
        "id": "slogan",
        "type": "op",
        "op": "text",
        "rngKey": "ccb/slogan",
