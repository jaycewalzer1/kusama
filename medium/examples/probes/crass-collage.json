{
  "version": "0.2",
  "profile": "default-v0",
  "assetPack": "core",
  "seed": 1977,
  "canvas": { "width": 800, "height": 1200, "ground": "#e2ded2", "brushScale": 1 },
  "palette": {
    "ink": "#121212",
    "paper": "#e2ded2",
    "blood": "#a41616",
    "grey": "#7d7a72",
    "smoke": "#3b3a36"
  },
  "meta": {
    "probe": "crass-collage",
    "target": "Gee Vaucher lineage: found fragments layered as an argument, photographic material set against clean type, anti-war content",
    "method": "the plate is a black rectangle and every 'photograph' in it is a pack fragment -- crowd, columns, beams, a bird -- filled either solid (silhouette) or with a fine charcoal hatch standing in for continuous tone. The argument is made by stacking order: state architecture behind, crowd beneath, sponsors on top, and the bird cut out of all of it.",
    "notDone": "there is no photographic or found material in the pack at all, so every 'photograph' is a fifteen-outline vector; hatch is not halftone and reads as engraving, and there is no way to knock type out of an image except by drawing it in the ground colour"
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "stock",
        "type": "op",
        "op": "wash",
        "rngKey": "crass/stock",
        "label": "cheap paper, so the white is never white",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "grey", "opacity": 34, "bleed": 0.22, "texture": [0.7, 0.4] }
        }
      },
      {
        "id": "kicker",
        "type": "op",
        "op": "text",
        "rngKey": "crass/kicker",
        "args": {
