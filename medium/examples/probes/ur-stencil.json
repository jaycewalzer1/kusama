        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "dim", "opacity": 30, "bleed": 0.14, "texture": [0.6, 0.35] }
        }
      },
      {
        "id": "trim",
