{
  "version": "0.2",
  "profile": "default-v0",
  "assetPack": "core",
  "seed": 4201,
  "canvas": { "width": 800, "height": 800, "ground": "#111112", "brushScale": 1 },
  "palette": {
    "black": "#111112",
    "steel": "#cfcfc9",
    "red": "#c1121f",
    "dim": "#3d3d3a"
  },
  "meta": {
    "probe": "ur-stencil-b",
    "target": "same lineage as ur-stencil, different object: a square record label rather than a poster -- centre hole, catalogue text, matrix numbers, one red mark",
    "method": "the composition is built from circle regions and a ring layout instead of a grid, to test whether the substrate's competence survives leaving the rectangle. Every circle is wrapped in a clip rect that contains it, because an unclipped solid circle is a 25-gon and a clipped one is a 64-gon (see docs/substrate-test/inventory.md). Letter spacing is done with `tracking` alone; the only spaces in the strings are the triple spaces that separate words.",
    "notDone": "text cannot be set on a curve -- there is no text-on-path -- so the catalogue type had to be set as straight lines above and below the spindle, which is the one thing on this sheet a real label would never do. The ring layout also has no sweep, so the red spokes are distributed around the whole circle rather than gathered into one arc."
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "plate-tone",
        "type": "op",
        "op": "wash",
        "rngKey": "urb/plate-tone",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 840 },
          "style": { "kind": "wash", "color": "dim", "opacity": 26, "bleed": 0.12, "texture": [0.55, 0.3] }
        }
      },
      {
        "id": "disc-clip",
        "type": "group",
        "label": "a clip rect that removes nothing, so the circle is tessellated at 64 segments instead of 25",
        "clip": { "type": "rect", "x": 96, "y": 96, "w": 608, "h": 608 },
        "children": [
          {
            "id": "label-disc",
            "type": "op",
            "op": "paint",
            "rngKey": "urb/label-disc",
            "args": {
              "region": { "type": "circle", "cx": 400, "cy": 400, "r": 300 },
              "style": { "kind": "solid", "color": "steel", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "ring-clip",
        "type": "group",
        "clip": { "type": "rect", "x": 128, "y": 128, "w": 544, "h": 544 },
        "children": [
          {
            "id": "disc-ring",
            "type": "op",
            "op": "paint",
            "rngKey": "urb/disc-ring",
            "args": {
              "region": { "type": "circle", "cx": 400, "cy": 400, "r": 268 },
              "style": { "kind": "solid", "color": "black", "opacity": 255 }
            }
          }
        ]
      },
      {
        "id": "spokes",
        "type": "repeat",
        "rngKey": "urb/spokes",
        "label": "steel spokes placed by angle, not by grid",
        "count": 24,
        "layout": { "type": "ring", "origin": [400, 400], "r": 232, "startAngle": 0 },
        "children": [
          {
            "id": "spoke",
            "type": "op",
            "op": "paint",
            "rngKey": "urb/spoke",
            "args": {
