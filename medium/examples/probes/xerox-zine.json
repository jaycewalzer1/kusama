            "count": 9,
            "layout": { "type": "line", "origin": [46, 344], "dx": 0, "dy": 43 },
            "jitter": { "translate": 5 },
            "children": [
              {
                "id": "streak",
                "type": "op",
                "op": "paint",
                "rngKey": "xz/streak",
