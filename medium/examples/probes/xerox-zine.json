          },
          {
            "id": "body-notice",
            "type": "macro",
            "macro": "quarantine",
            "rngKey": "xz/body-notice",
            "label": "a boxed notice, hatched so it reads as a screened panel",
            "args": {
              "x": 542,
              "y": 800,
              "w": 216,
              "h": 124,
              "style": { "kind": "hatch", "brush": "rotring", "color": "toner", "spacing": 3, "angle": 0, "rand": 0.4, "layers": 1 },
              "boxBrush": "rotring",
              "boxColor": "toner",
              "boxWeight": 2,
              "label": "REMOVED   BY   HAND",
              "labelFont": "grotesque",
              "labelSize": 12,
              "labelTracking": 2
            }
          },
          {
            "id": "body-stamp",
            "type": "op",
            "op": "text",
            "rngKey": "xz/body-stamp",
            "args": {
              "text": "COPY   OF   A   COPY   OF   A   COPY",
              "font": "grotesque",
              "size": 34,
              "x": 46,
              "y": 998,
              "align": "left",
              "color": "toner",
              "tracking": 3
            }
          },
          {
            "id": "body-strike",
            "type": "op",
            "op": "stroke",
            "rngKey": "xz/body-strike",
            "label": "biro through the line, the one hand-made mark",
            "args": {
              "points": [[44, 990], [220, 984], [430, 994], [640, 982], [762, 990]],
              "brush": "2B",
              "color": "toner",
              "weight": 2,
              "curve": 0.35
            }
          }
        ]
      },
      {
        "id": "footer",
        "type": "group",
        "label": "black footer bar with the line knocked out of it",
