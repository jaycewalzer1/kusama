{
  "version": "0.2",
  "profile": "default-v0",
  "assetPack": "core",
  "seed": 4101,
  "canvas": { "width": 800, "height": 1200, "ground": "#e9e7e0", "brushScale": 1 },
  "palette": {
    "toner": "#0d0d0d",
    "paper": "#e9e7e0",
    "grey": "#8e8b83"
  },
  "meta": {
    "probe": "xerox-zine",
    "target": "a photocopied zine page: high contrast black on grey copier stock, degraded edges, typewriter body text, visible generational loss",
    "method": "black is solid/255 (plain p5 fill, hard aliased edge). Loss is faked: paper-coloured flecks scattered into the black, toner flecks scattered onto the paper, and paper-coloured drag streaks across the silhouette. There is no threshold and no post-process, so nothing here is actual degradation of an image; it is degradation drawn on top of a clean one."
  },
  "root": {
    "id": "root",
    "type": "group",
    "children": [
      {
        "id": "stock",
        "type": "op",
        "op": "wash",
        "rngKey": "xz/stock",
        "label": "copier stock: the only brush-made surface on the page",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 840, "h": 1240 },
          "style": { "kind": "wash", "color": "grey", "opacity": 34, "bleed": 0.08, "texture": [0.85, 0.55] }
        }
      },
      {
        "id": "gutter-shadow",
        "type": "op",
        "op": "wash",
        "rngKey": "xz/gutter",
        "label": "the dark band a copier leaves along the spine edge",
        "args": {
          "region": { "type": "rect", "x": -20, "y": -20, "w": 66, "h": 1240 },
          "style": { "kind": "wash", "color": "toner", "opacity": 96, "bleed": 0.34, "texture": [0.7, 0.4] }
        }
      },
      {
        "id": "masthead",
        "type": "group",
        "label": "solid black bar with the title knocked out of it",
        "children": [
          {
            "id": "masthead-bar",
            "type": "op",
            "op": "paint",
            "rngKey": "xz/masthead-bar",
            "args": {
              "region": { "type": "rect", "x": 46, "y": 74, "w": 712, "h": 168 },
              "style": { "kind": "solid", "color": "toner", "opacity": 255 }
            }
          },
          {
            "id": "masthead-title",
            "type": "op",
            "op": "text",
            "rngKey": "xz/masthead-title",
            "args": {
              "text": "DEAD   AIR",
              "font": "grotesque",
              "size": 96,
              "x": 402,
              "y": 190,
              "align": "center",
              "color": "paper",
              "tracking": 6
            }
          },
          {
            "id": "masthead-dropout",
            "type": "repeat",
            "rngKey": "xz/masthead-dropout",
            "label": "toner dropout: the third-generation copy loses the solid",
            "count": 110,
            "layout": { "type": "scatter", "origin": [48, 76], "w": 706, "h": 162 },
            "jitter": { "rotate": 40, "scale": 0.7 },
            "children": [
              {
                "id": "dropout-fleck",
                "type": "op",
                "op": "paint",
                "rngKey": "xz/dropout-fleck",
                "args": {
                  "region": { "type": "rect", "x": 0, "y": 0, "w": 5, "h": 2 },
                  "style": { "kind": "solid", "color": "paper", "opacity": 255 }
                }
              }
            ]
          },
          {
            "id": "masthead-issue",
            "type": "op",
            "op": "text",
            "rngKey": "xz/masthead-issue",
            "args": {
              "text": "ISSUE   SEVEN   /   FREE   /   NOT   FOR   RESALE",
              "font": "serif",
              "size": 13,
              "x": 402,
              "y": 268,
              "align": "center",
              "color": "toner",
              "tracking": 1.5
            }
          }
        ]
      },
      {
        "id": "plate",
        "type": "group",
