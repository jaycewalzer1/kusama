                  "region": { "type": "rect", "x": 0, "y": 0, "w": 712, "h": 1.5 },
                  "style": { "kind": "solid", "color": "paper", "opacity": 190 }
                }
              }
            ]
          },
          {
            "id": "plate-bite",
            "type": "op",
            "op": "cover",
            "rngKey": "xz/plate-bite",
            "label": "a corner of the plate torn away back to bare stock",
            "args": {
              "region": {
                "type": "polygon",
                "points": [[604, 306], [758, 306], [758, 402], [716, 384], [690, 396], [656, 358], [628, 366]]
              },
              "softness": 0
            }
          }
        ]
      },
      {
        "id": "body",
        "type": "group",
        "label": "typewriter setting, faked with the serif face and hard tracking",
        "children": [
          {
            "id": "body-rule",
            "type": "op",
            "op": "rule",
            "rngKey": "xz/body-rule",
            "args": { "from": [46, 780], "to": [758, 780], "brush": "charcoal", "color": "toner", "weight": 2.5 }
          },
          {
            "id": "body-text",
            "type": "op",
            "op": "text",
            "rngKey": "xz/body-text",
            "args": {
              "text": "THE   MACHINE   RUNS   ALL   NIGHT   AND   NOBODY   SIGNS   FOR   IT.   EVERY   COPY   IS   WORSE   THAN   THE   LAST   AND   THAT   IS   THE   ONLY   HONEST   RECORD   WE   HAVE.",
