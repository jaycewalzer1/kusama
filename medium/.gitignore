# Build output. dist/ is the real one; dist-* are scratch builds used when more than one
# thing is being built at once, and must never be committed.
dist/
dist-*/

# The hermetic browser, fetched into the repo by PLAYWRIGHT_BROWSERS_PATH. Large, and pinned
# by revision in vendor/VERSIONS.md rather than by being checked in.
.browsers/

node_modules/

# Scratch render output. goldens/ and examples/ are deliberately NOT ignored.
out/
