{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    // The renderer is plain ESM shared with the browser. It is copied through to dist so Node can
    // import it; the page is always served the source files. Types come from the .d.ts siblings.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["env/**/*.ts", "cli/**/*.ts", "tests/**/*.ts", "renderer/**/*.js"],
  "exclude": ["node_modules", "dist", "vendor"]
}
