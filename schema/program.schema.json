{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medium.invalid/schema/program.schema.json",
  "title": "Program",
  "description": "The whole state of a picture. A finite tree of typed nodes; there is no free code anywhere in it. Unknown fields are rejected under every executable key. Inert commentary is allowed only under label, note, decisions and meta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "assetPack", "canvas", "seed", "root"],
  "properties": {
    "version": { "const": "0.2" },
    "profile": { "type": "string", "minLength": 1 },
    "assetPack": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "ground", "brushScale"],
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "ground": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "brushScale": { "type": "number", "minimum": 0.25, "maximum": 8 }
      }
    },
    "palette": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "print": {
      "description": "The print pass: an ordered list of post-process stages run once, on the finished canvas, in Node, after the render has been proven to repeat. Never inside the settle loop and never instead of it -- a threshold is a machine for making two different images agree, so putting one inside a self-consistency check would certify nondeterminism as determinism.",
      "type": "array",
      "items": { "$ref": "#/$defs/printStage" }
    },
    "meta": { "$ref": "#/$defs/meta" },
    "root": { "$ref": "#/$defs/group" }
  },

  "$defs": {
    "printStage": {
      "oneOf": [
        {
          "description": "Hard two-tone cut at a luminance. The photocopier's only opinion.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "cut", "dark", "light"],
          "properties": {
            "stage": { "const": "threshold" },
            "cut": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
            "dark": { "$ref": "#/$defs/color" },
            "light": { "$ref": "#/$defs/color" }
          }
        },
        {
          "description": "Quantise each channel to N evenly spaced levels.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "levels"],
          "properties": {
            "stage": { "const": "posterize" },
            "levels": { "type": "integer", "minimum": 2, "maximum": 8 }
          }
        },
        {
          "description": "Screen the image as dots or lines on a rotated grid.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "shape", "cell", "angle", "ink", "paper"],
          "properties": {
            "stage": { "const": "halftone" },
            "shape": { "enum": ["dot", "line"] },
            "cell": { "type": "number", "minimum": 2, "maximum": 32 },
            "angle": { "type": "number", "minimum": 0, "maximum": 180 },
            "ink": { "$ref": "#/$defs/color" },
            "paper": { "$ref": "#/$defs/color" }
          }
        },
        {
          "description": "Seeded per-pixel luminance noise.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "rngKey", "amount"],
          "properties": {
            "stage": { "const": "grain" },
            "rngKey": { "$ref": "#/$defs/printRngKey" },
            "amount": { "type": "number", "minimum": 0, "maximum": 1 },
            "mono": { "description": "One offset for all three channels, rather than one each. Default true.", "type": "boolean" }
          }
        },
        {
          "description": "Pull the colour plates apart by whole pixels, each plate's offset drawn from the print stream.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "rngKey", "amount"],
          "properties": {
            "stage": { "const": "misregister" },
            "rngKey": { "$ref": "#/$defs/printRngKey" },
            "amount": { "description": "Maximum plate displacement in pixels; the actual offsets are seeded.", "type": "number", "minimum": 0, "maximum": 1 },
            "spread": { "description": "Scales `amount` into pixels. amount 1 with spread 3 means plates move up to 3px.", "type": "number", "minimum": 0, "maximum": 3 }
          }
        },
        {
          "description": "Tint the whole sheet toward a stock colour and darken the corners.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "tint", "amount"],
          "properties": {
            "stage": { "const": "paper" },
            "tint": { "$ref": "#/$defs/color" },
            "amount": { "type": "number", "minimum": 0, "maximum": 1 },
            "vignette": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "description": "Generation loss: blur, cut, spread and drop out, N times over, each pass on the last pass's result. This is a photocopy of a photocopy, and iteration is the whole point of it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "rngKey", "passes", "cut", "dark", "light"],
          "properties": {
            "stage": { "const": "generation" },
            "rngKey": { "$ref": "#/$defs/printRngKey" },
            "passes": { "type": "integer", "minimum": 1, "maximum": 6 },
            "cut": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
            "dark": { "$ref": "#/$defs/color" },
            "light": { "$ref": "#/$defs/color" },
            "blur": { "description": "Radius of a box blur run before each cut, in pixels.", "type": "integer", "minimum": 0, "maximum": 3 },
            "spread": { "description": "Dilate the dark set by this many pixels after each cut: toner thickening.", "type": "integer", "minimum": 0, "maximum": 3 },
            "dropout": { "description": "Fraction of dark pixels that fail to transfer, per pass.", "type": "number", "minimum": 0, "maximum": 0.5 },
            "speck": { "description": "Fraction of light pixels dirtied, per pass.", "type": "number", "minimum": 0, "maximum": 0.5 }
          }
        }
      ]
    },

    "color": { "$ref": "paintstyle.schema.json#/$defs/color" },
    "style": { "$ref": "paintstyle.schema.json#/$defs/paintStyle" },

    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$", "maxLength": 64 },
    "rngKey": {
      "description": "Opaque and permanent. A node's randomness derives from this and nothing else, which is why moving or reordering a node cannot change its marks. Edits never change it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "printRngKey": {
      "description": "The same promise as a node's rngKey, kept for a print stage: this stage's noise derives from this string and nothing else, so inserting a stage ahead of it cannot re-grain it. Required on exactly the three stages that draw from the print stream -- grain, misregister and generation -- and absent from the four that do not, because a key on a stage that never draws would advertise a sensitivity it does not have. Must be unique within a program's print list. Edits never change it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": -10000, "maximum": 10000 }
    },

    "meta": {
      "description": "Inert. Never read by the renderer; carries provenance and commentary.",
      "type": "object"
    },
    "label": { "type": "string", "maxLength": 200 },
    "note": { "type": "string", "maxLength": 2000 },
    "decisions": { "type": "array", "items": { "type": "string", "maxLength": 200 } },

    "transform": {
      "description": "Applied as translate, then rotate, then scale. Degrees, clockwise positive on screen.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "translate": { "$ref": "#/$defs/point" },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }
      }
    },

    "clip": {
      "description": "p5.brush cannot clip, so clipping is done geometrically on the CPU with Sutherland-Hodgman, which is correct only for a convex clip (NOTES L1). Rect and circle are convex by construction; a polygon is checked for convexity in Node and refused if it is not, because a concave clip does not fail loudly here -- it quietly produces a wrong shape. Not a fragment: fragment outlines are concave. Text inside a clipped group is still refused, since a glyph has no polygon to intersect.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "w", "h"],
          "properties": {
            "type": { "const": "rect" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cx", "cy", "r"],
          "properties": {
            "type": { "const": "circle" },
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "r": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "points"],
          "properties": {
            "type": { "const": "polygon" },
            "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
          }
        }
      ]
    },

    "region": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "w", "h"],
          "properties": {
            "type": { "const": "rect" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cx", "cy", "r"],
          "properties": {
            "type": { "const": "circle" },
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "r": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "points"],
          "properties": {
            "type": { "const": "polygon" },
            "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
          }
        },
        { "$ref": "#/$defs/fragmentPlacement" }
      ]
    },

    "fragmentPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "x", "y", "span"],
      "properties": {
        "type": { "const": "fragment" },
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "span": { "description": "Size of the fragment's unit box in local units.", "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360 },
        "flipX": { "type": "boolean" }
      }
    },

    "node": {
      "oneOf": [
        { "$ref": "#/$defs/group" },
        { "$ref": "#/$defs/repeat" },
        { "$ref": "#/$defs/macro" },
        { "$ref": "#/$defs/op" }
      ]
    },

    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "group" },
        "transform": { "$ref": "#/$defs/transform" },
        "clip": { "$ref": "#/$defs/clip" },
        "blend": {
          "description": "How this subtree's marks composite onto what is already down. Carried to the leaves, so it is per mark rather than per layer: two overlapping stamps of one hatch multiply with each other as well as with the ink beneath, which is what overprinting ink does (NOTES R11). The nearest enclosing group wins, and `normal` opts back out. Only values the profile allows, which is none in V0 (NOTES R3). `overlay` and `difference` are absent on purpose: p5's WEBGL path silently ignores them.",
          "type": "string",
          "enum": ["normal", "multiply", "screen", "exclusion"]
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "label": { "$ref": "#/$defs/label" },
        "note": { "$ref": "#/$defs/note" },
        "decisions": { "$ref": "#/$defs/decisions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "rngKey", "count", "layout", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "repeat" },
        "rngKey": { "$ref": "#/$defs/rngKey" },
        "seedOffset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "layout": { "$ref": "#/$defs/layout" },
        "jitter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "translate": { "type": "number", "minimum": 0, "maximum": 2000 },
            "rotate": { "type": "number", "minimum": 0, "maximum": 360 },
            "scale": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "label": { "$ref": "#/$defs/label" },
        "note": { "$ref": "#/$defs/note" },
        "decisions": { "$ref": "#/$defs/decisions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "origin", "cols", "dx", "dy"],
          "properties": {
            "type": { "const": "grid" },
            "origin": { "$ref": "#/$defs/point" },
            "cols": { "type": "integer", "minimum": 1, "maximum": 256 },
            "dx": { "type": "number" },
            "dy": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "origin", "dx", "dy"],
          "properties": {
            "type": { "const": "line" },
            "origin": { "$ref": "#/$defs/point" },
            "dx": { "type": "number" },
            "dy": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "origin", "r"],
          "properties": {
            "type": { "const": "ring" },
            "origin": { "$ref": "#/$defs/point" },
            "r": { "type": "number", "exclusiveMinimum": 0 },
            "startAngle": { "type": "number", "minimum": -360, "maximum": 360 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "origin", "w", "h"],
          "properties": {
            "type": { "const": "scatter" },
            "origin": { "$ref": "#/$defs/point" },
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },

    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "macro", "rngKey", "args"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "macro" },
        "macro": { "enum": ["frame", "motif", "quarantine"] },
        "rngKey": { "$ref": "#/$defs/rngKey" },
        "seedOffset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "args": { "type": "object" },
        "label": { "$ref": "#/$defs/label" },
        "note": { "$ref": "#/$defs/note" },
        "decisions": { "$ref": "#/$defs/decisions" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "allOf": [
        { "if": { "properties": { "macro": { "const": "frame" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/frameArgs" } } } },
        { "if": { "properties": { "macro": { "const": "motif" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/motifArgs" } } } },
        { "if": { "properties": { "macro": { "const": "quarantine" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/quarantineArgs" } } } }
      ]
    },

    "frameArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h", "style", "color"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "inset": { "type": "number" },
        "style": { "enum": ["corners", "full", "dots"] },
        "brush": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "weight": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "arm": { "type": "number", "exclusiveMinimum": 0 },
        "count": { "type": "integer", "minimum": 3, "maximum": 200 },
        "dotRadius": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 255 }
      }
    },

    "motifArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "size"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360 },
        "brush": { "type": "string" },
        "color": { "$ref": "#/$defs/color" }
      }
    },

    "quarantineArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h", "style"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "style": { "$ref": "#/$defs/style" },
        "boxBrush": { "type": "string" },
        "boxColor": { "$ref": "#/$defs/color" },
        "boxWeight": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "label": { "type": "string", "maxLength": 120 },
        "labelFont": { "type": "string" },
        "labelSize": { "type": "number", "minimum": 4, "maximum": 400 },
        "labelTracking": { "type": "number", "minimum": -5, "maximum": 40 }
      }
    },

    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "op", "rngKey", "args"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "op" },
        "op": { "enum": ["wash", "paint", "stroke", "fragment", "text", "rule", "cover", "spray"] },
        "rngKey": { "$ref": "#/$defs/rngKey" },
        "seedOffset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "args": { "type": "object" },
        "label": { "$ref": "#/$defs/label" },
        "note": { "$ref": "#/$defs/note" },
        "decisions": { "$ref": "#/$defs/decisions" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "allOf": [
        { "if": { "properties": { "op": { "const": "wash" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/washArgs" } } } },
        { "if": { "properties": { "op": { "const": "paint" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/paintArgs" } } } },
        { "if": { "properties": { "op": { "const": "stroke" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/strokeArgs" } } } },
        { "if": { "properties": { "op": { "const": "fragment" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/fragmentArgs" } } } },
        { "if": { "properties": { "op": { "const": "text" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/textArgs" } } } },
        { "if": { "properties": { "op": { "const": "rule" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/ruleArgs" } } } },
        { "if": { "properties": { "op": { "const": "cover" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/coverArgs" } } } },
        { "if": { "properties": { "op": { "const": "spray" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sprayArgs" } } } }
      ]
    },

    "sprayArgs": {
      "description": "A seeded particle spray about an anchor: an aerosol can rather than a brush. The particle count is a pure function of density and r, so the validator knows it in Node and can refuse an unaffordable cloud before a browser starts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "r", "density", "falloff", "brush", "color", "weight"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "r": { "description": "Radius of the cone where it meets the sheet.", "type": "number", "minimum": 0.5, "maximum": 4000 },
        "density": { "description": "Particles per 100 square canvas units of the disc.", "type": "number", "minimum": 0.05, "maximum": 20 },
        "falloff": { "description": "1 is exactly a uniform disc. Above 1 the cloud tightens to the centre and the edge goes to overspray; below 1 it hollows into a ring, the way a can held too close sprays.", "type": "number", "minimum": 0.2, "maximum": 6 },
        "brush": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "weight": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "drip": { "$ref": "#/$defs/drip" }
      }
    },

    "drip": {
      "description": "Runs of wet paint leaving the spray, as seeded random walks starting from particles the spray actually laid down. An exact count rather than a per-particle probability: the worst case of a probability is every particle, and a bound nothing can be budgeted against is not a bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "length", "wander"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 40 },
        "length": { "type": "number", "minimum": 0, "maximum": 120 },
        "wander": { "description": "Furthest a drip may stagger sideways per step of its walk.", "type": "number", "minimum": 0, "maximum": 12 }
      }
    },

    "paintArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "style"],
      "properties": {
        "region": { "$ref": "#/$defs/region" },
        "style": { "$ref": "#/$defs/style" }
      }
    },

    "washArgs": {
      "description": "wash is paint restricted to a wash style; it exists as its own operator because it is the one that reads as 'colour laid down' rather than 'shape filled'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "style"],
      "properties": {
        "region": { "$ref": "#/$defs/region" },
        "style": { "$ref": "paintstyle.schema.json#/$defs/wash" }
      }
    },

    "strokeArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "brush", "color", "weight"],
      "properties": {
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
        "brush": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "weight": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "closed": { "type": "boolean" },
        "curve": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "fragmentArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "span", "style"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "span": { "description": "Size of the fragment's unit box in local units.", "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360 },
        "flipX": { "type": "boolean" },
        "tear": { "$ref": "#/$defs/tear" },
        "style": { "$ref": "#/$defs/style" }
      }
    },

    "tear": {
      "description": "A torn paper edge. The fragment outline is resampled into segments of roughly `segment` units and every resampled vertex is displaced along the outline's normal by up to `roughness * segment`, drawn from the node's own geometry substream. Purely geometric and computed in Node, so it costs no extra marks and the same node tears the same way every time. Absent means the outline is used as authored. Gated on the profile carrying limits.maxTearPoints, so v0 refuses it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["roughness", "segment"],
      "properties": {
        "roughness": { "description": "Displacement as a fraction of `segment`. 0 is a clean edge.", "type": "number", "minimum": 0, "maximum": 1 },
        "segment": { "description": "Segment length in local units. Small is a fine deckle, large is a coarse rip.", "type": "number", "minimum": 1, "maximum": 60 }
      }
    },

    "textArgs": {
      "description": "`font` names a face the profile allows and the asset pack declares. The pack carries every face's SHA256, so the pack hash covers the type as well as the shapes, and the renderer refuses a face whose bytes on disk do not match.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "font", "size", "x", "y", "color"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "font": { "type": "string" },
        "size": { "type": "number", "minimum": 4, "maximum": 400 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "color": { "$ref": "#/$defs/color" },
        "align": { "enum": ["left", "center", "right"] },
        "tracking": { "type": "number", "minimum": -5, "maximum": 40 },
        "leading": { "description": "Line advance as a multiple of size. Default 1.25, which is the number V0 hard-coded.", "type": "number", "minimum": 0.5, "maximum": 3 },
        "maxWidth": { "type": "number", "exclusiveMinimum": 0 },
        "rotate": { "description": "Degrees about the anchor (x, y), clockwise on screen.", "type": "number", "minimum": -360, "maximum": 360 },
        "skew": { "description": "Horizontal shear in degrees about the anchor: positive leans the tops of the glyphs right.", "type": "number", "minimum": -60, "maximum": 60 },
        "stretch": { "description": "Non-uniform scale [sx, sy] about the anchor, applied after rotate and skew.", "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 } },
        "case": { "description": "Force the case of the string before it is measured or drawn.", "enum": ["upper", "lower"] },
        "jitter": {
          "description": "Per-glyph displacement drawn from this node's own `glyph` stream. Ransom notes and zines: every letter set slightly wrong, and wrong the same way every time.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "translate": { "type": "number", "minimum": 0, "maximum": 200 },
            "rotate": { "type": "number", "minimum": 0, "maximum": 90 },
            "scale": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },

    "ruleArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "brush", "color", "weight"],
      "properties": {
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "brush": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "weight": { "type": "number", "minimum": 0.1, "maximum": 20 }
      }
    },

    "coverArgs": {
      "description": "Paints the ground colour back over a region. The one way to take something away.",
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "softness"],
      "properties": {
        "region": { "$ref": "#/$defs/region" },
        "softness": { "type": "number", "minimum": 0, "maximum": 0.6 },
        "destroys": {
          "description": "Source node ids this covering claims to have destroyed: the marks it was painted over the top of, named in the tree so that what was taken away is readable without diffing pixels. Optional, and a claim rather than an instruction -- the renderer draws exactly the same picture with it and without it. env/validate.ts refuses the program if the claim is not geometrically true: every name must exist in the resolved output, must be drawn before this covering rather than after it, and must have bounds that actually overlap the covering's. A macro id counts for its parts.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
